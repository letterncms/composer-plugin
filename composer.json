{
    "name": "letterncms/composer-plugin",
    "description": "Puts plugins in the site's plugins/ folder and keeps a site's front controller current.",
    "type": "composer-plugin",
    "version": "0.1.0",
    "license": "MIT",
    "require": {
        "composer-plugin-api": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "Cms\\ComposerPlugin\\": "src/"
        }
    },
    "extra": {
        "class": "Cms\\ComposerPlugin\\Plugin"
    }
}
