{
    "name": "letterncms/composer-plugin",
    "description": "Puts plugins in the site's plugins/ folder and kits in kits/, and keeps a site's front controller current.",
    "type": "composer-plugin",
    "version": "0.1.0",
    "license": "MIT",
    "require": {
        "composer-plugin-api": "^2.3"
    },
    "require-dev": {
        "composer/composer": "^2.3",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Cms\\ComposerPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cms\\ComposerPlugin\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "class": "Cms\\ComposerPlugin\\Plugin"
    }
}
